def install_udev():
    if os.geteuid() != 0:
        sys.exit("Bitte mit sudo ausführen, z. B.:  sudo ~/.local/bin/fanatec-tuning --udev")
    os.makedirs(os.path.dirname(UDEV_PATH), exist_ok=True)
    with open(UDEV_PATH, "w") as f:
        f.write(UDEV_RULE)
    subprocess.run(["udevadm", "control", "--reload-rules"], check=False)
    subprocess.run(["udevadm", "trigger", "--subsystem-match=ftec_tuning", "--action=add"], check=False)
    print(f"udev-Regel angelegt: {UDEV_PATH}")
    print("Falls das Tool noch keine Rechte hat: Base einmal aus- und wieder einschalten.")


