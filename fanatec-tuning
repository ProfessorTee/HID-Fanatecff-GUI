# ------------------------------------------------------- Dienst & CLI -----

def post(path, body=None, timeout=3):
    req = urllib.request.Request(URL + path, data=json.dumps(body or {}).encode(),
                                 headers={"Content-Type": "application/json"}, method="POST")
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def daemon_running():
    try:
        with urllib.request.urlopen(URL + "/api/state", timeout=1):
            return True
    except OSError:
        return False


def serve(open_browser):
    try:
        server = ThreadingHTTPServer((HOST, PORT), Handler)
    except OSError:
        if open_browser:
            webbrowser.open(URL)
        return
    print(f"Fanatec Tuning läuft auf {URL}  (Beenden mit Strg+C)")
    if not tuning_dir():
        print("Hinweis: Kein Fanatec-Wheel gefunden – ist die Base eingeschaltet?")
    elif not is_writable():
        print("Hinweis: " + PERM_HINT)
    threading.Thread(target=monitor, daemon=True).start()
    if open_browser:
        threading.Timer(0.5, lambda: webbrowser.open(URL)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


def cli_profile(action, name=None):
    """--next / --apply: an den laufenden Dienst schicken, sonst direkt setzen."""
    try:
        if action == "next":
            res = post("/api/next")
        else:
            res = post("/api/profile/apply", {"name": name, "reason": "per Tastenkürzel"})
        print("Profil gesetzt:", res["running"]["profile"])
        return
    except urllib.error.HTTPError as e:
        sys.exit(json.load(e).get("error", str(e)))
    except OSError:
        pass
    # Dienst läuft nicht
    if action == "next":
        sys.exit("Der Hintergrunddienst läuft nicht (fanatec-tuning --daemon).")
    try:
        apply_profile(name, reason="per Befehl")
        print("Profil gesetzt:", name)
    except (ValueError, RuntimeError) as e:
        sys.exit(str(e))


def write_desktop(path, exec_line, name, comment, extra=""):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(f"[Desktop Entry]\nType=Application\nName={name}\nComment={comment}\n"
                f"Exec={exec_line}\nIcon={icon_name()}\nTerminal=false\n{extra}")


def stop_other_instances():
    """Beendet andere laufende Instanzen (Dienst/Fenster), damit die neue Version greift."""
    me, parent = os.getpid(), os.getppid()
    stopped = []
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or int(pid) in (me, parent):
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = [a.decode("utf-8", "replace") for a in f.read().split(b"\0") if a]
        except OSError:
            continue
        if len(argv) >= 2 and os.path.basename(argv[0]).startswith("python") \
                and os.path.basename(argv[1]) == "fanatec-tuning":
            try:
                os.kill(int(pid), 15)
                stopped.append(int(pid))
            except OSError:
                pass
    for _ in range(30):
        if not any(os.path.exists(f"/proc/{p}") for p in stopped):
            break
        time.sleep(0.1)
    return bool(stopped)


EMBED_KEY = "X-Fanatec-Code="   # so steckt das Programm in der .desktop-Variante


def source_code():
    """Quelltext dieses Programms – auch wenn es aus der .desktop-Datei heraus läuft."""
    import base64, zlib
    with open(os.path.realpath(sys.argv[0]), encoding="utf-8") as f:
        text = f.read()
    for line in text.splitlines():
        if line.startswith(EMBED_KEY):
            return zlib.decompress(base64.b64decode(line[len(EMBED_KEY):])).decode("utf-8")
    return text


def installed_code():
    try:
        with open(BIN_PATH, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return None


def install(quiet=False):
    me = os.path.realpath(sys.argv[0])
    os.makedirs(os.path.dirname(BIN_PATH), exist_ok=True)
    stop_other_instances()
    if me != os.path.realpath(BIN_PATH):
        code = source_code()
        with open(BIN_PATH + ".new", "w", encoding="utf-8") as f:
            f.write(code)
        os.replace(BIN_PATH + ".new", BIN_PATH)
    os.chmod(BIN_PATH, 0o755)
    os.makedirs(os.path.dirname(ICON_PATH), exist_ok=True)
    import base64
    with open(ICON_PATH, "wb") as f:
        f.write(base64.b64decode(ICON_PNG))
    if os.path.exists(OLD_ICON_PATH):
        os.remove(OLD_ICON_PATH)
    exec_line = BIN_PATH
    write_desktop(DESKTOP_PATH, exec_line, "Fanatec Tuning",
                  "Tuning-Menü der Fanatec-Wheelbase einstellen", "Categories=Game;Settings;\n")
    write_desktop(AUTOSTART_PATH, f"{BIN_PATH} --daemon", "Fanatec Tuning (Hintergrund)",
                  "Erkennt Spiele und lädt passende Wheel-Profile", "X-KDE-autostart-phase=2\n")
    print(f"Installiert: {BIN_PATH}")
    try:
        import PySide6  # noqa: F401
    except ImportError:
        print("Für die Desktop-App fehlt noch PySide6:  sudo pacman -S pyside6")
    print("Startmenü-Eintrag „Fanatec Tuning“ angelegt.")
    print("Autostart eingerichtet – ab dem nächsten Login läuft die Spielerkennung automatisch.")
    subprocess.Popen([sys.executable, BIN_PATH, "--daemon"], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    print("Hintergrunddienst gestartet.")
    for tool in ("kbuildsycoca6", "kbuildsycoca5"):   # KDE-Menü sofort aktualisieren
        if which(tool):
            subprocess.Popen([tool], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            break
    if tuning_dir() and not is_writable():
        print("\nNoch keine Schreibrechte. Einmalig ausführen:\n  sudo ~/.local/bin/fanatec-tuning --udev")


def launch(args=()):
    """Wird die Datei von woanders gestartet (z. B. per Doppelklick im Downloads-Ordner):
    installieren bzw. aktualisieren, falls nötig, danach die installierte App starten."""
    me = os.path.realpath(sys.argv[0])
    if me != os.path.realpath(BIN_PATH):
        new = not os.path.exists(BIN_PATH)
        if new or installed_code() != source_code():
            install()
            notify("Fanatec Tuning " + ("installiert" if new else "aktualisiert"),
                   "Ab jetzt auch im Startmenü – die Spielerkennung läuft im Hintergrund.")
    for launcher in launcher_copies(me):
        fix_launcher_icon(launcher)
    os.execv(sys.executable, [sys.executable, BIN_PATH] + [a for a in args if a != "--launch"])


def uninstall():
