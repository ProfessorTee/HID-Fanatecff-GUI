        def fill_profile_combos(self):
            self.g_add_combo.clear()
            self.g_add_combo.addItems(self.profile_names)
            cur = self.games.get("after_exit", "") if self.games else ""
            self.after_combo.clear()
            self.after_combo.addItem("nichts ändern", "")
            for n in self.profile_names:
                self.after_combo.addItem(f"Profil „{n}“ laden", n)
            i = self.after_combo.findData(cur)
            self.after_combo.setCurrentIndex(max(i, 0))

        def update_games(self, games, running):
            js = json.dumps(games, sort_keys=True) + str(running)
            if js == self.games_json:
                return
            focus = QtWidgets.QApplication.focusWidget()
            if focus in (self.g_name, self.g_exe) and self.games is not None:
                return   # nicht beim Tippen überschreiben
            self.games_json = js
            self.games = json.loads(json.dumps(games))
            self.running_game = running
            self.glist.blockSignals(True)
            self.glist.clear()
            for g in self.games["games"]:
                it = QtWidgets.QListWidgetItem(("▶ " if g["name"] == running else "") + g["name"])
                it.setToolTip(g["exe"])
                self.glist.addItem(it)
            self.glist.blockSignals(False)
            self.game_row = min(self.game_row, len(self.games["games"]) - 1)
            self.glist.setCurrentRow(self.game_row)
            self.on_game_selected(self.game_row)
            self.fill_profile_combos()

        def current_game(self):
            if self.games and 0 <= self.game_row < len(self.games["games"]):
                return self.games["games"][self.game_row]
            return None

        def on_game_selected(self, row):
            self.game_row = row
            g = self.current_game()
            self.gform.setEnabled(g is not None)
            self.g_name.setText(g["name"] if g else "")
            self.g_exe.setText(g["exe"] if g else "")
            self.g_profiles.clear()
            if g:
                for i, p in enumerate(g["profiles"]):
                    self.g_profiles.addItem(("★ " if i == 0 else "    ") + p)

        def save_games(self, msg="Gespeichert"):
            self.games_json = ""   # nächsten Stand neu übernehmen
            self.call("/api/games", self.games, msg)

        def on_game_new(self):
            name, ok = QtWidgets.QInputDialog.getText(self, "Neues Spiel", "Name des Spiels:")
            if ok and name.strip():
                self.games["games"].append({"name": name.strip(), "exe": "neues-spiel.exe", "profiles": []})
                self.game_row = len(self.games["games"]) - 1
                self.save_games("Spiel angelegt – jetzt noch das Programm eintragen")
                self.pages.setCurrentIndex(1)
                self.g_exe.setFocus(); self.g_exe.selectAll()

        def on_game_delete(self):
            g = self.current_game()
            if g and QtWidgets.QMessageBox.question(self, "Spiel entfernen", f"„{g['name']}“ entfernen?") \
                    == QtWidgets.QMessageBox.Yes:
                self.games["games"].pop(self.game_row)
                self.game_row = max(0, self.game_row - 1)
                self.save_games("Spiel entfernt")

        def on_game_edited(self):
            g = self.current_game()
            if not g:
                return
            name, exe = self.g_name.text().strip(), self.g_exe.text().strip()
            if not name or not exe or (name == g["name"] and exe == g["exe"]):
                return
            g["name"], g["exe"] = name, exe
            self.save_games()

        def on_pick_exe(self):
            exes = self.call("/api/running")
            if exes is None:
                return
            if not exes:
                QtWidgets.QMessageBox.information(self, "Keine Spiele gefunden",
                                                  "Es läuft gerade kein Windows-Programm.\n"
                                                  "Starte das Spiel und versuche es dann nochmal.")
                return
            exe, ok = QtWidgets.QInputDialog.getItem(self, "Laufendes Programm", "Welches ist das Spiel?",
                                                     exes, 0, False)
            if ok and exe:
                self.g_exe.setText(exe)
                self.on_game_edited()

        def on_game_profile_add(self):
            g, p = self.current_game(), self.g_add_combo.currentText()
            if g and p and p not in g["profiles"]:
                g["profiles"].append(p)
                self.save_games(f"„{p}“ zugeordnet")

        def selected_game_profile(self):
            g, row = self.current_game(), self.g_profiles.currentRow()
            if g and 0 <= row < len(g["profiles"]):
                return g, row
            self.statusBar().showMessage("Bitte zuerst ein Profil in der Liste auswählen", 3000)
            return None, None

        def on_game_profile_star(self):
            g, row = self.selected_game_profile()
            if g and row > 0:
                g["profiles"].insert(0, g["profiles"].pop(row))
                self.save_games(f"„{g['profiles'][0]}“ ist jetzt das Startprofil")

        def on_game_profile_remove(self):
            g, row = self.selected_game_profile()
            if g:
                p = g["profiles"].pop(row)
                self.save_games(f"„{p}“ entfernt")

        def on_after_changed(self):
            if self.games is not None:
                self.games["after_exit"] = self.after_combo.currentData() or ""
                self.save_games()

        # ---------- Tray ----------
        def build_tray(self):
            self.tray = None
            if not QtWidgets.QSystemTrayIcon.isSystemTrayAvailable():
                return
            self.tray = QtWidgets.QSystemTrayIcon(self.app_icon, self)
            self.tray.setToolTip("Fanatec Tuning")
            self.tray_menu = QtWidgets.QMenu()
            self.tray.setContextMenu(self.tray_menu)
            self.tray.activated.connect(lambda r: self.toggle_window()
                                        if r == QtWidgets.QSystemTrayIcon.Trigger else None)
            self.tray_state = None
            self.tray.show()

        def update_tray(self, active):
            if not self.tray:
                return
            key = (tuple(self.profile_names), active)
            if key == self.tray_state:
                return
            self.tray_state = key
            m = self.tray_menu
            m.clear()
            m.addSection("Profil")
            for n in self.profile_names:
                a = m.addAction(n)
                a.setCheckable(True); a.setChecked(n == active)
                a.triggered.connect(lambda _=False, n=n: self.call("/api/profile/apply", {"name": n},
                                                                   f"Profil „{n}“ gesetzt"))
            m.addSeparator()
            m.addAction(QtGui.QIcon.fromTheme("window"), "Fenster anzeigen", self.show_window)
            m.addAction(QtGui.QIcon.fromTheme("application-exit"), "Beenden", self.quit_app)
            self.tray.setToolTip("Fanatec Tuning" + (f" – {active}" if active else ""))

        def toggle_window(self):
            if self.isVisible() and not self.isMinimized():
                self.hide()
            else:
                self.show_window()

        def show_window(self):
            self.showNormal(); self.raise_(); self.activateWindow()

        def quit_app(self):
            self.quitting = True
            QtWidgets.QApplication.quit()

        def closeEvent(self, ev):
            if self.tray and not self.quitting:
                ev.ignore()
                self.hide()
                if not self.tray_hint_shown:
                    self.tray_hint_shown = True
                    self.tray.showMessage("Fanatec Tuning", "Läuft im Systemabschnitt weiter. "
                                          "Rechtsklick aufs Symbol zum Profilwechsel oder Beenden.",
                                          self.app_icon, 4000)
            else:
                ev.accept()
                QtWidgets.QApplication.quit()

    if not ensure_daemon():
        print("Hintergrunddienst konnte nicht gestartet werden.")
        return True
    app = QtWidgets.QApplication(sys.argv)
    app.setApplicationName("Fanatec Tuning")
    app.setDesktopFileName("fanatec-tuning")
    app.setQuitOnLastWindowClosed(False)
    w = MainWindow()
    w.show()
    if os.environ.get("FTEC_SHOT"):   # nur für Tests: Screenshots speichern und beenden
        shot = os.environ["FTEC_SHOT"]
        QtCore.QTimer.singleShot(1500, lambda: w.grab().save(shot + "-1.png"))
        QtCore.QTimer.singleShot(1700, lambda: w.pages.setCurrentIndex(1))
        QtCore.QTimer.singleShot(2500, lambda: w.grab().save(shot + "-2.png"))
        QtCore.QTimer.singleShot(2700, w.quit_app)
    app.exec()
    return True


def main():
    args = sys.argv[1:]
    if "--launch" in args:
        return launch(args)
    if "--install" in args:
        return install()
    if "--uninstall" in args:
        return uninstall()
    if "--udev" in args:
        return install_udev()
    if "--next" in args:
        return cli_profile("next")
    if "--apply" in args:
        i = args.index("--apply")
        if i + 1 >= len(args):
            sys.exit("Bitte Profilnamen angeben: fanatec-tuning --apply NAME")
        return cli_profile("apply", args[i + 1])
    if "-h" in args or "--help" in args:
        return print(__doc__)
    if "--daemon" in args or "--no-browser" in args:
        return serve(open_browser=False)
    if os.path.realpath(sys.argv[0]) != os.path.realpath(BIN_PATH) and not os.environ.get("FTEC_NO_SELFINSTALL"):
        return launch(args)   # Selbstinstallation beim Start aus dem Downloads-Ordner
    if "--web" not in args and ensure_pyside6() and run_gui():
        return
    if "--web" not in args:
        print("Hinweis: Für die Desktop-App bitte PySide6 installieren:  sudo pacman -S pyside6\n"
              "Öffne stattdessen die Browser-Version …")
        notify("PySide6 fehlt", "Für die Desktop-App: sudo pacman -S pyside6 – öffne die Browser-Version.")
    # Browser-Version: läuft der Dienst schon, nur die Seite öffnen
    if daemon_running():
        webbrowser.open(URL)
        return
    serve(open_browser=True)


if __name__ == "__main__":
    main()
