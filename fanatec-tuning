        # ---------- Server ----------
        def call(self, path, body=None, ok=None):
            try:
                st = post(path, body) if body is not None else get_json(path)
            except urllib.error.HTTPError as e:
                try:
                    msg = json.load(e).get("error", str(e))
                except ValueError:
                    msg = str(e)
                self.statusBar().showMessage("⚠ " + msg, 8000)
                return None
            except OSError:
                self.statusBar().showMessage("⚠ Hintergrunddienst nicht erreichbar", 5000)
                return None
            if path != "/api/running" and isinstance(st, dict) and "values" in st:
                self.apply_state(st)
                if st.get("warnings"):
                    self.statusBar().showMessage("⚠ " + " | ".join(st["warnings"]), 8000)
                elif ok:
                    self.statusBar().showMessage(ok, 3000)
            return st

        def refresh(self):
            try:
                st = get_json("/api/state")
            except OSError:
                self.status.setText("<span style='color:#da4453'>Dienst nicht erreichbar</span>")
                self.update_setup()
                return
            self.apply_state(st)

        def apply_state(self, st):
            self.state = st
            ok = st["connected"]
            self.status.setText("<span style='color:%s'>%s</span>" %
                                (("#27ae60", "● Wheel verbunden") if ok else ("#da4453", "● Kein Wheel gefunden")))
            self.setup_tick -= 1
            if self.setup_tick <= 0:
                self.setup_tick = 5
                self.update_setup()
            self.warn.setText("Keine Schreibrechte – Werte nur lesbar. Einmalig im Terminal: "
                              "sudo ~/.local/bin/fanatec-tuning --udev  und die Base neu einschalten.")
            run = st["running"]
            if run.get("game"):
                self.running_label.setText(f"▶ {run['game']} läuft"
                                           + (f"  ·  Profil: {run['profile']}" if run.get("profile") else ""))
            self.running_label.setVisible(bool(run.get("game")))
            self.update_profiles(list(st["profiles"]), run.get("profile"))
            self.update_values(st["values"], st["writable"])
            self.update_games(st["games"], run.get("game"))
            self.update_tray(run.get("profile"))


        # ---------- Einrichtung ----------
        def update_setup(self):
            try:
                issues = setup_issues()
            except Exception as e:  # Einrichtungs-Check darf die App nie blockieren
                issues = [(f"Einrichtungs-Check fehlgeschlagen: {e}", None, None)]
            key = [(t, b) for t, b, _ in issues]
            if key == self.setup_key:
                return
            self.setup_key = key
            while self.setup_lay.count():
                item = self.setup_lay.takeAt(0)
                if item.layout():
                    while item.layout().count():
                        w = item.layout().takeAt(0).widget()
                        if w:
                            w.deleteLater()
                elif item.widget():
                    item.widget().deleteLater()
            for text, button, cmd in issues:
                row = QtWidgets.QHBoxLayout()
                lbl = QtWidgets.QLabel("⚠ " + text); lbl.setWordWrap(True)
                row.addWidget(lbl, 1)
                if button and cmd:
                    b = QtWidgets.QPushButton(button)
                    b.clicked.connect(lambda _=False, c=cmd: self.run_setup(c))
                    row.addWidget(b)
                self.setup_lay.addLayout(row)
            self.setup_box.setVisible(bool(issues))

        def run_setup(self, cmd):
            proc = QtCore.QProcess(self)
            proc.finished.connect(lambda *_: (setattr(self, "setup_key", None), self.update_setup(),
                                              self.refresh()))
            proc.start(cmd[0], cmd[1:])
            self.statusBar().showMessage("Einrichtung läuft … ggf. Passwort eingeben", 5000)

