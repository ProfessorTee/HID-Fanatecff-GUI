                lbl.setWordWrap(True)
                grid.addWidget(lbl, r, 0)
                if typ == "toggle":
                    off_l, on_l = TOGGLE_LABELS.get(key, ("aus", "an"))
                    cb = QtWidgets.QCheckBox()
                    cb.toggled.connect(lambda on, k=key, c=cb, a=lo, b=hi, o=on_l, f_=off_l: (
                        c.setText(o if on else f_), self.send(k, b if on else a)))
                    grid.addWidget(cb, r, 1, 1, 2)
                    self.param_widgets[key] = ("toggle", cb, (lo, hi, off_l, on_l))
                else:
                    spin = QtWidgets.QSpinBox()
                    spin.setRange(lo, hi); spin.setSingleStep(step); spin.setMinimumWidth(80)
                    spin.setKeyboardTracking(False)
                    if typ == "slider":
                        sl = QtWidgets.QSlider(Qt.Horizontal)
                        sl.setRange(lo, hi); sl.setSingleStep(step); sl.setPageStep(step * 5)
                        sl.valueChanged.connect(lambda v, s=spin, sl_=sl, k=key, st=step: self.slider_moved(k, sl_, s, v, st))
                        sl.sliderReleased.connect(lambda k=key, sl_=sl: self.send(k, sl_.value()))
                        spin.valueChanged.connect(lambda v, sl_=sl, k=key: (self.set_quiet(sl_, v), self.send(k, v)))
                        grid.addWidget(sl, r, 1)
                        self.param_widgets[key] = ("slider", (sl, spin), None)
                    else:
                        spin.valueChanged.connect(lambda v, k=key: self.send(k, v))
                        self.param_widgets[key] = ("number", spin, None)
                    grid.addWidget(spin, r, 2)
            lay.addStretch()
            hint = QtWidgets.QLabel("<small style='color:gray'>Änderungen werden sofort in den aktuellen "
                                    "Slot der Base geschrieben und dort gespeichert.</small>")
            lay.addWidget(hint)
            scroll = QtWidgets.QScrollArea()
            scroll.setWidgetResizable(True)
            scroll.setFrameShape(QtWidgets.QFrame.NoFrame)
            scroll.setWidget(inner)
            return scroll

        @staticmethod
        def set_quiet(w, v):
            w.blockSignals(True); w.setValue(v); w.blockSignals(False)

        def slider_moved(self, key, sl, spin, v, step):
            v = round(v / step) * step
            self.set_quiet(spin, v)
            if not sl.isSliderDown():   # Tastatur/Mausrad: kurz warten, dann senden
                self.send(key, v, delay=350)

        def send(self, key, value, delay=0):
            if key in self.pending:
                self.pending.pop(key).stop()
            if delay:
                t = QtCore.QTimer(self); t.setSingleShot(True)
                t.timeout.connect(lambda: (self.pending.pop(key, None), self.send(key, value)))
                self.pending[key] = t; t.start(delay)
                return
            self.call("/api/set", {"key": key, "value": int(value)}, f"{key} = {int(value)}")

        def update_values(self, values, writable):
            focus = QtWidgets.QApplication.focusWidget()
            for key, (typ, w, extra) in self.param_widgets.items():
                present = key in values
                widgets = w if isinstance(w, tuple) else (w,)
                for x in widgets:
                    x.setEnabled(present and writable)
                if not present or key in self.pending:
                    continue
                v = values[key]
                if typ == "toggle":
                    lo, hi, off_l, on_l = extra
                    w.blockSignals(True); w.setChecked(v >= hi); w.blockSignals(False)
                    w.setText(on_l if v >= hi else off_l)
                elif typ == "slider":
                    sl, spin = w
                    if sl.isSliderDown() or spin is focus:
                        continue
                    self.set_quiet(sl, v); self.set_quiet(spin, v)
                elif w is not focus:
                    self.set_quiet(w, v)

