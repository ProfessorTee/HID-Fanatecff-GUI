#!/usr/bin/env python3
"""Fanatec Tuning – Desktop-App für den hid-fanatecff-Treiber
mit automatischen Profilen pro Spiel.

Liest und schreibt die Werte unter /sys/class/ftec_tuning/<gerät>/.
Benötigt nur Python; für die Desktop-App zusätzlich PySide6 (sudo pacman -S pyside6),
ohne PySide6 öffnet sich die Browser-Version.

  fanatec-tuning                 Desktop-App öffnen. Von woanders gestartet (z. B. per
                                 Doppelklick im Downloads-Ordner) installiert bzw.
                                 aktualisiert sich die Datei dabei selbst.
  fanatec-tuning --web           Oberfläche stattdessen im Browser öffnen
  fanatec-tuning --daemon        nur im Hintergrund laufen (für den Autostart)
  fanatec-tuning --next          nächstes Profil des laufenden Spiels (für Tastenkürzel)
  fanatec-tuning --apply NAME    Profil NAME setzen
  fanatec-tuning --install       nach ~/.local/bin + Startmenü + Autostart
  fanatec-tuning --launch        installieren/aktualisieren falls nötig, dann starten
  fanatec-tuning --uninstall     alles wieder entfernen (Profile bleiben)
  sudo fanatec-tuning --udev     Schreibrechte einrichten (einmalig)
"""
