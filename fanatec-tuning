def icon_name():
    # Absoluter Pfad: funktioniert sofort, ohne auf den Icon-Cache von KDE zu warten
    return ICON_PATH if os.path.exists(ICON_PATH) else "input-gaming"


def desktop_dir():
    """Schreibtisch-Ordner laut ~/.config/user-dirs.dirs (z. B. ~/Schreibtisch)."""
    try:
        with open(os.path.expanduser("~/.config/user-dirs.dirs"), encoding="utf-8") as f:
            for line in f:
                if line.startswith("XDG_DESKTOP_DIR="):
                    return os.path.expandvars(line.split("=", 1)[1].strip().strip('"'))
    except OSError:
        pass
    return os.path.expanduser("~/Desktop")


def launcher_copies(me):
    """Die gestartete Starter-Datei plus Kopien davon auf dem Schreibtisch und in Downloads."""
    found = [me] if me.endswith(".desktop") else []
    for folder in (desktop_dir(), os.path.expanduser("~/Downloads")):
        for path in glob.glob(os.path.join(folder, "*.desktop")) + glob.glob(os.path.join(folder, "*", "*.desktop")):
            try:
                with open(path, encoding="utf-8") as f:
                    if "\nX-Fanatec-Code=" in f.read() and path not in found:
                        found.append(path)
            except OSError:
                pass
    return found


def fix_launcher_icon(path):
    """Setzt in der gestarteten .desktop-Datei das eigene Icon ein."""
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().split("\n")
        want = "Icon=" + icon_name()
        changed = False
        for i, line in enumerate(lines):
            if line.startswith("Icon=") and line != want:
                lines[i] = want
                changed = True
        if changed:
            with open(path, "w", encoding="utf-8") as f:
                f.write("\n".join(lines))
    except OSError:
        pass


PERM_HINT = ("Keine Schreibrechte auf die Tuning-Dateien. Einmalig ausführen: "
             "sudo ~/.local/bin/fanatec-tuning --udev  – danach die Base aus- und wieder einschalten.")

LOCK = threading.RLock()


# ---------------------------------------------------------------- Wheel -----

def tuning_dir():
    if os.environ.get("FTEC_DIR"):
        return os.environ["FTEC_DIR"]
    found = sorted(glob.glob("/sys/class/ftec_tuning/*"))
    return found[0] if found else None


def read_all():
    d = tuning_dir()
    if not d:
        return None
    values = {}
    for key in KEYS:
        try:
            with open(os.path.join(d, key)) as f:
                values[key] = int(f.read().strip())
        except (OSError, ValueError):
            pass
    return values


def write_value(key, value):
    if key not in KEYS:
        raise ValueError(f"Unbekannter Wert: {key}")
    d = tuning_dir()
    if not d:
        raise RuntimeError("Kein Fanatec-Wheel gefunden. Ist die Base an?")
    try:
        with LOCK, open(os.path.join(d, key), "w") as f:
            f.write(f"{int(value)}\n")
    except PermissionError:
        raise RuntimeError(PERM_HINT)
    except OSError as e:
        raise RuntimeError(f"{key} = {value} wurde abgelehnt ({e.strerror}). "
                           "Wert außerhalb des erlaubten Bereichs?")


def is_writable():
    d = tuning_dir()
    return bool(d) and os.access(os.path.join(d, "FF"), os.W_OK)


def notify(title, body=""):
    try:
        subprocess.Popen(["notify-send", "-a", "Fanatec Tuning", "-i",
                          ICON_PATH if os.path.exists(ICON_PATH) else "input-gaming",
                          "-t", "3000", title, body],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


# --------------------------------------------------------------- Dateien -----

def _read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def _write_json(path, data):
    os.makedirs(CFG_DIR, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
    os.replace(tmp, path)


def load_profiles():
    """Alle Profile. Neue Standardprofile werden einmalig ergänzt,
    gelöschte Standardprofile bleiben gelöscht."""
    with LOCK:
        profiles = _read_json(PROFILE_FILE, {})
        if not isinstance(profiles, dict):
            profiles = {}
        seeded = set(_read_json(SEEDED_FILE, []))
        missing = [n for n in DEFAULT_PROFILES if n not in seeded]
        if missing:
            for n in missing:
                profiles.setdefault(n, DEFAULT_PROFILES[n])
            _write_json(PROFILE_FILE, profiles)
            _write_json(SEEDED_FILE, sorted(seeded | set(missing)))
        return profiles


def save_profiles(profiles):
    with LOCK:
        _write_json(PROFILE_FILE, profiles)


def load_games():
    with LOCK:
        data = _read_json(GAMES_FILE, None)
        if not isinstance(data, dict) or "games" not in data:
            data = json.loads(json.dumps(DEFAULT_GAMES))
            _write_json(GAMES_FILE, data)
        data.setdefault("after_exit", "")
        return data


def save_games(data):
    games = []
    for g in data.get("games", []):
        name = str(g.get("name", "")).strip()[:60]
        exe = str(g.get("exe", "")).strip()[:120]
        if not name or not exe:
            raise ValueError("Jedes Spiel braucht einen Namen und eine .exe")
        profs = [str(p) for p in g.get("profiles", []) if str(p).strip()]
        games.append({"name": name, "exe": exe, "profiles": profs})
    with LOCK:
        _write_json(GAMES_FILE, {"games": games, "after_exit": str(data.get("after_exit", ""))})


# -------------------------------------------------------- Profile setzen -----

class Status:
    game = None          # Name des erkannten Spiels
    profile = None       # zuletzt gesetztes Profil
    index = 0            # Position in der Profilliste des Spiels
    message = ""         # letzte Meldung (z. B. Fehler)


def apply_profile(name, reason=""):
    profiles = load_profiles()
    if name not in profiles:
        raise ValueError(f"Profil '{name}' gibt es nicht")
    errors = []
    for key, value in profiles[name].items():
        if key in PROFILE_KEYS:
            try:
                write_value(key, value)
            except RuntimeError as e:
                if str(e) == PERM_HINT:
                    Status.message = PERM_HINT
                    raise
                errors.append(str(e))
    Status.profile = name
    Status.message = " | ".join(errors)
    if reason:
        sen = profiles[name].get("SEN")
        notify(f"Profil „{name}“", reason + (f" · {sen}°" if sen else ""))
    return errors


def next_profile():
    """Nächstes Profil des laufenden Spiels (ohne Spiel: alle Profile durchgehen)."""
    games = load_games()["games"]
    game = next((g for g in games if g["name"] == Status.game), None)
    profiles = load_profiles()
    names = [p for p in (game["profiles"] if game else []) if p in profiles] or list(profiles)
    if not names:
        raise ValueError("Keine Profile vorhanden")
    if Status.profile in names:
        idx = (names.index(Status.profile) + 1) % len(names)
    else:
        idx = 0
    Status.index = idx
    apply_profile(names[idx], reason=f"{idx + 1}/{len(names)}" + (f" – {Status.game}" if Status.game else ""))
    return names[idx]


# ------------------------------------------------------- Spielerkennung -----

def running_exes():
    """Dateinamen (klein geschrieben) aller laufenden Programme des Benutzers.
    Bei Wine/Proton steht im argv[0] der Windows-Pfad, z. B. C:\\...\\acs.exe."""
    uid = os.getuid()
    names = set()
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            if os.stat(f"/proc/{pid}").st_uid != uid:
                continue
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv0 = f.read().split(b"\0", 1)[0].decode("utf-8", "replace")
        except OSError:
            continue
        if argv0:
            names.add(argv0.replace("\\", "/").rsplit("/", 1)[-1].lower())
    return names


WINE_SYSTEM_EXES = {
    "explorer.exe", "services.exe", "winedevice.exe", "plugplay.exe", "svchost.exe", "rpcss.exe",
    "tabtip.exe", "conhost.exe", "wineboot.exe", "start.exe", "steam.exe", "steamwebhelper.exe",
    "steamerrorreporter.exe", "crashpad_handler.exe", "rundll32.exe", "winemenubuilder.exe",
    "cmd.exe", "rpcss.exe", "mscorsvw.exe", "unitycrashhandler64.exe", "crashreportclient.exe",
}


def running_game_exes():
    """Laufende .exe-Programme ohne Wine-/Steam-Hilfsprozesse (für die Auswahl im GUI)."""
    return sorted(n for n in running_exes() if n.endswith(".exe") and n not in WINE_SYSTEM_EXES)


def monitor():
    while True:
        try:
            games = load_games()
            running = running_exes()
            found = next((g for g in games["games"] if g["exe"].lower() in running), None)
            name = found["name"] if found else None
            if name != Status.game:
                Status.game, Status.index = name, 0
                if found:
                    profiles = load_profiles()
                    start = next((p for p in found["profiles"] if p in profiles), None)
                    if start and tuning_dir():
                        apply_profile(start, reason=f"{name} erkannt")
                elif games.get("after_exit") and tuning_dir():
                    apply_profile(games["after_exit"], reason="Spiel beendet")
        except Exception as e:  # der Wächter darf nie abstürzen
            Status.message = str(e)
        time.sleep(POLL_SECONDS)


# ---------------------------------------------------------- Webserver -----

def state():
    return {
        "connected": tuning_dir() is not None,
        "writable": is_writable(),
        "values": read_all() or {},
        "params": [dict(zip(("key", "label", "desc", "min", "max", "step", "group", "type"), p),
                        labels=TOGGLE_LABELS.get(p[0], ("aus", "an")))
                   for p in PARAMS],
        "profiles": load_profiles(),
        "games": load_games(),
        "running": {"game": Status.game, "profile": Status.profile, "message": Status.message},
    }


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def _send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            self._send(200, PAGE.encode(), "text/html; charset=utf-8")
        elif self.path == "/api/state":
            self._send(200, state())
        elif self.path == "/api/running":
            self._send(200, running_game_exes())
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        # Nur Anfragen von der eigenen Seite (oder ohne Origin, z. B. --next) annehmen
        origin = self.headers.get("Origin")
        if origin and origin not in (URL, f"http://localhost:{PORT}"):
            self._send(403, {"error": "forbidden"})
            return
        try:
            length = int(self.headers.get("Content-Length", 0))
            body = json.loads(self.rfile.read(length) or b"{}")
            warnings = []
            if self.path == "/api/set":
                write_value(body["key"], body["value"])
            elif self.path == "/api/profile/apply":
                warnings = apply_profile(body["name"], reason=body.get("reason", ""))
            elif self.path == "/api/next":
                next_profile()
            elif self.path == "/api/profile/save":
                name = str(body["name"]).strip()[:40]
                if not name:
                    raise ValueError("Bitte einen Namen angeben")
                values = read_all() or {}
                profiles = load_profiles()
                profiles[name] = {k: values[k] for k in PROFILE_KEYS if k in values}
                save_profiles(profiles)
            elif self.path == "/api/profile/delete":
                name = body["name"]
                profiles = load_profiles()
                profiles.pop(name, None)
                save_profiles(profiles)
                games = load_games()
                for g in games["games"]:
                    g["profiles"] = [p for p in g["profiles"] if p != name]
                if games.get("after_exit") == name:
                    games["after_exit"] = ""
                save_games(games)
            elif self.path == "/api/games":
                save_games(body)
            else:
                self._send(404, {"error": "not found"})
                return
            st = state()
            st["warnings"] = warnings
            self._send(200, st)
        except (KeyError, ValueError, RuntimeError, TypeError) as e:
            self._send(400, {"error": str(e)})


