def which(cmd):
    return shutil.which(cmd) is not None


def aur_helper():
    return next((h for h in ("paru", "yay") if which(h)), None)


def terminal_cmd(script):
    """Befehl, der `script` sichtbar in einem Terminal ausführt."""
    for term, args in (("konsole", ["--hold", "-e"]), ("kitty", ["--hold"]), ("alacritty", ["--hold", "-e"]),
                       ("gnome-terminal", ["--"]), ("xterm", ["-hold", "-e"])):
        if which(term):
            return [term] + args + ["sh", "-c", script]
    return None


def setup_issues():
    """Liste offener Einrichtungsschritte: (Text, Knopf-Text, Befehl oder None)."""
    issues = []
    if os.environ.get("FTEC_DIR"):
        return issues
    loaded = os.path.isdir("/sys/module/hid_fanatec")
    available = loaded
    if not available:
        try:
            available = subprocess.run(["modinfo", "-n", "hid-fanatec"], stdout=subprocess.DEVNULL,
                                       stderr=subprocess.DEVNULL).returncode == 0
        except OSError:
            available = bool(glob.glob(f"/usr/lib/modules/{os.uname().release}/**/hid-fanatec*",
                                       recursive=True))
    if not available:
        helper = aur_helper()
        if helper:
            cmd = terminal_cmd(f"{helper} -S --needed hid-fanatecff-dkms && sudo modprobe hid-fanatec && "
                               f"echo hid-fanatec | sudo tee {MODLOAD_PATH} >/dev/null && "
                               "echo && echo Fertig – Fenster kann geschlossen werden.")
            issues.append(("Der Fanatec-Treiber (hid-fanatecff) ist nicht installiert.",
                           "Treiber installieren", cmd))
        else:
            issues.append(("Der Fanatec-Treiber (hid-fanatecff) ist nicht installiert. Installiere das "
                           "AUR-Paket hid-fanatecff-dkms (z. B. mit paru) oder siehe "
                           "github.com/gotzl/hid-fanatecff.", None, None))
        return issues
    if not loaded or not os.path.exists(MODLOAD_PATH):
        issues.append(("Der Fanatec-Treiber wird noch nicht automatisch geladen.", "Treiber aktivieren",
                       ["pkexec", "sh", "-c", f"modprobe hid-fanatec; echo hid-fanatec > {MODLOAD_PATH}"]))
    if tuning_dir() is None:
        if loaded:
            issues.append(("Kein Fanatec-Wheel gefunden – ist die Base eingeschaltet und per USB verbunden? "
                           "Nach dem Aktivieren des Treibers die Base einmal aus- und einschalten.", None, None))
    elif not is_writable():
        issues.append(("Noch keine Schreibrechte für das Tuning-Menü.", "Rechte einrichten",
                       ["pkexec", sys.executable, BIN_PATH, "--udev"]))
    return issues


def ensure_pyside6():
    """Fehlt PySide6, wird es (nach Passwortabfrage) über pacman nachinstalliert."""
    try:
        import PySide6  # noqa: F401
        return True
    except ImportError:
        pass
    if not (which("pacman") and which("pkexec")):
        return False
    notify("Fanatec Tuning", "Installiere die Desktop-Oberfläche (PySide6) – bitte Passwort eingeben.")
    ok = subprocess.run(["pkexec", "pacman", "-S", "--needed", "--noconfirm", "pyside6"]).returncode == 0
    if ok:
        os.execv(sys.executable, [sys.executable] + sys.argv)   # neu starten, jetzt mit PySide6
    return False


