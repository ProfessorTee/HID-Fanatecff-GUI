#!/usr/bin/env xdg-open
[Desktop Entry]
Type=Application
Name=Fanatec Tuning
Comment=Double-click: installs or updates Fanatec Tuning and starts it
Comment[de]=Doppelklick: installiert bzw. aktualisiert Fanatec Tuning und startet es
Icon=input-gaming
Terminal=false
Categories=Game;Settings;
Exec=sh -c "command -v python3 >/dev/null || pkexec pacman -S --needed --noconfirm python || { notify-send -a 'Fanatec Tuning' 'Python 3 fehlt' 'Bitte Python 3 installieren.'; exit 1; }; exec python3 -c 'import sys,zlib,base64;f=sys.argv[1];sys.argv=[f];exec(zlib.decompress(base64.b64decode(open(f).read().split()[-1].split(chr(61),1)[1])))' \\$0" %k
X-Fanatec-
