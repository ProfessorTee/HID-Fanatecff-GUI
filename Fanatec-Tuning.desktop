#!/usr/bin/env xdg-open
[Desktop Entry]
Type=Application
Name=Fanatec Tuning
Comment=Double-click: downloads, installs or updates Fanatec Tuning and starts it
Comment[de]=Doppelklick: lädt Fanatec Tuning herunter, installiert bzw. aktualisiert es und startet es
Icon=input-gaming
Terminal=false
Categories=Game;Settings;
Exec=sh -c "f=\\${XDG_RUNTIME_DIR:-/tmp}/fanatec-tuning-download; b=\\$HOME/.local/bin/fanatec-tuning; if curl -fsSL -o \\$f https://github.com/ProfessorTee/HID-Fanatecff-GUI/releases/latest/download/fanatec-tuning; then chmod +x \\$f; exec \\$f --launch; elif [ -x \\$b ]; then exec \\$b; else notify-send -a 'Fanatec Tuning' 'Download fehlgeschlagen / failed' 'github.com/ProfessorTee/HID-Fanatecff-GUI'; fi"
X-Fanatec-Launcher=1
